# Copy to .env.local and fill in. Never commit the real file.

# The Express API from server/. Server components fetch this directly;
# client components go through the same value via NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Firebase Web SDK config, from the Firebase console (Project settings ->
# General -> Your apps -> Web app). These are public by design — they name a
# project, they do not grant access to it — but the project itself has to
# exist and have Email/Password sign-in enabled under Authentication.
#
# Without these, sign-in and sign-up render but cannot authenticate, and every
# request that needs a token gets a clear "sign in to continue" rather than a
# silent failure.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
