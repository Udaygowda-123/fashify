# Copy to .env and fill in. Never commit .env.
#
# Only MONGODB_URI and REDIS_URL are needed to boot, run the tests and use the
# catalog, cart and inventory. The third-party blocks below are each optional:
# without them the matching feature reports itself as unconfigured at startup
# and its routes return 503 rather than pretending to work. See README.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# The client origin CORS is locked to. Comma-separate for more than one.
CLIENT_ORIGIN=http://localhost:3000

# --- data stores (required) ---------------------------------------------------
# Include the database name in the path, or it silently writes to "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/fashify?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379

# --- secrets this server generates and verifies itself ------------------------
# Signs the guest bag cookie. Any long random string; changing it logs out
# every guest bag. Generate with: openssl rand -hex 32
COOKIE_SECRET=change-me-openssl-rand-hex-32

# --- Firebase Admin (auth) ----------------------------------------------------
# From the service account JSON. Keep the private key's \n escapes intact and
# wrap the whole value in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# --- Razorpay (payments, test mode) ------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook in the Razorpay dashboard. Signature
# verification is skipped ONLY when this is empty and NODE_ENV is not
# production; in production an empty value is a startup error.
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (email) -----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Fashify <orders@example.in>"
# Where the low-stock digest goes.
ADMIN_ALERT_EMAIL=

# --- Cloudinary (admin image uploads) ----------------------------------------
CLOUDINARY_URL=

# --- tunables ----------------------------------------------------------------
# How long a bag holds stock for. The brief's figure is 20 minutes.
RESERVATION_TTL_MINUTES=20
# How long an untouched cart survives before the sweeper drops it.
CART_TTL_DAYS=30
# Hours of inactivity before a bag counts as abandoned.
ABANDONED_CART_HOURS=4
# Set to "false" to boot without starting the cron jobs (useful in tests).
ENABLE_JOBS=true
